# The local stack gives each backend service its own port. Deployed builds
# set VITE_API_ORIGIN instead and reach every service under it.
# Configuration, not code: no host lives in a page.
VITE_API_ORIGIN_ORGANIZATION=http://localhost:8081
VITE_API_ORIGIN_AUDIT=http://localhost:8082
VITE_API_ORIGIN_NOTIFICATION=http://localhost:8083
VITE_API_ORIGIN_USER=http://localhost:8084
VITE_API_ORIGIN_IDENTITY=http://localhost:8093
VITE_API_ORIGIN_AUTHORIZATION=http://localhost:8086
VITE_API_ORIGIN_BILLING=http://localhost:8089
VITE_API_ORIGIN_WEBHOOKS=http://localhost:8087
