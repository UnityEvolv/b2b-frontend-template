{
  "name": "@b2b-template/app-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "The mobile app: React Native with Expo, sharing the API client, permissions, translations and theme with the web apps.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc -p tsconfig.json",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "apk": "node tools/apk.mjs",
    "install:device": "node tools/apk.mjs --install",
    "update": "eas update --auto"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@b2b-template/api": "0.0.0",
    "@b2b-template/client": "0.0.0",
    "@b2b-template/core": "0.0.0",
    "@b2b-template/i18n": "0.0.0",
    "@b2b-template/theme": "0.0.0",
    "expo": "~57.0.25",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.19",
    "expo-crypto": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.23",
    "expo-web-browser": "~57.0.3",
    "i18next": "^25.0.0",
    "qrcode": "1.5.4",
    "react": "19.2.3",
    "react-i18next": "^15.0.0",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "typescript": "^5.6.0"
  }
}
