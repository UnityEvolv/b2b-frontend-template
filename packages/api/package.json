{
  "name": "@b2b-template/api",
  "version": "0.0.0",
  "private": true,
  "description": "The typed client for every backend service, generated from the services' OpenAPI contracts. Never edit src/generated or specs by hand.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "generate": "node scripts/generate.mjs",
    "sync": "node scripts/sync.mjs"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  }
}
